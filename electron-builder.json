{
  "appId": "com.kidus.studio",
  "productName": "Kidus Studio",
  "directories": {
    "output": "dist-exe"
  },
  "files": [
    "dist/**/*",
    "server.ts",
    "server-zip.ts",
    "electron-main.cjs",
    "package.json",
    "node_modules/**/*"
  ],
  "extraMetadata": {
    "main": "electron-main.cjs"
  },
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "artifactName": "Kidus Studio.exe"
  }
}
